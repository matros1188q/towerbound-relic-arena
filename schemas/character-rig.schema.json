{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matros1188q.github.io/towerbound-relic-arena/schemas/character-rig.schema.json",
  "title": "Towerbound 2D Cutout Character Rig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "character_id",
    "source_image",
    "canvas",
    "root",
    "parts",
    "clips"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "character_id": {
      "type": "string",
      "pattern": "^(hero|enemy|boss)\\.[a-z0-9-]+$"
    },
    "source_image": {
      "type": "string",
      "pattern": "^assets/characters/(heroes|enemies|bosses)/[a-z0-9-]+\\.png$"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/clip"
      }
    }
  },
  "$defs": {
    "vec2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "image",
        "parent",
        "pivot",
        "z_index"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "image": {
          "type": "string",
          "pattern": "^assets/characters/rigs/[a-z0-9-]+/[a-z0-9_-]+\\.png$"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "pivot": {
          "$ref": "#/$defs/vec2"
        },
        "anchor": {
          "$ref": "#/$defs/vec2"
        },
        "z_index": {
          "type": "integer"
        },
        "visible": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "duration_ms",
        "loop",
        "tracks",
        "events"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "loop": {
          "type": "boolean"
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "part",
              "keyframes"
            ],
            "properties": {
              "part": {
                "type": "string"
              },
              "keyframes": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "at_ms"
                  ],
                  "properties": {
                    "at_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "rotation_deg": {
                      "type": "number"
                    },
                    "scale_x": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "scale_y": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "at_ms"
            ],
            "properties": {
              "id": {
                "enum": [
                  "anticipation",
                  "release",
                  "projectile",
                  "impact",
                  "recovery",
                  "footstep",
                  "sound"
                ]
              },
              "at_ms": {
                "type": "integer",
                "minimum": 0
              },
              "payload": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
